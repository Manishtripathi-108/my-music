meta {
  name: Get Technical Info - File Not Found (404)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/media/technical?path={{nonExistentAudioPath}}
  body: none
  auth: bearer
}

params:query {
  path: {{nonExistentAudioPath}}
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 404
  res.body.success: eq false
  res.body.error.code: eq NOT_FOUND
}

tests {
  test("should return 404 for non-existent file", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().success).to.be.false;
  });
}
