meta {
  name: Stream Artwork - Audio Source Binary Stream (200)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/media/artwork?path={{sampleAudioPathFlac}}
  body: none
  auth: bearer
}

params:query {
  path: {{sampleAudioPathFlac}}
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: in [200, 404]
}

tests {
  test("returns extracted image binary or 404 if no embedded artwork", function() {
    expect([200, 404]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.getHeader('content-type')).to.include('image/');
    }
  });
}
