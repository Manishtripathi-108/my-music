meta {
  name: Patch Tags - Full Audio Metadata Set (200)
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/media/tags
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "path": "{{sampleAudioPath}}",
    "tags": {
      "Title": "Master of Puppets",
      "Artist": "Metallica",
      "Album": "Master of Puppets (Remastered)",
      "Year": 1986,
      "Genre": ["Heavy Metal", "Thrash Metal"],
      "TrackNumber": 2
    },
    "preserveOriginal": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.success: eq true
  res.body.data.filePath: isDefined
}

tests {
  test("should write tags and return 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.success).to.be.true;
  });
}
