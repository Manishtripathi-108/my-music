meta {
  name: Extract Artwork Metadata (Happy Path)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/media/artwork
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "path": "{{sampleAudioPathFlac}}",
    "forceRefresh": false
  }
}

assert {
  res.status: in [200, 404]
}

tests {
  test("returns extracted artwork metadata or 404 if no embedded art", function() {
    expect([200, 404]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.getBody().success).to.be.true;
      expect(res.getBody().data.cachedPath).to.be.a('string');
      expect(res.getBody().data.filename).to.be.a('string');
      expect(res.getBody().data.mimeType).to.be.a('string');
    }
  });
}
