meta {
  name: Write Tags - Preserve Original Backup
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/media/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "path": "{{sampleAudioPath}}",
    "tags": {
      "Comment": "Backup preserved test"
    },
    "preserveOriginal": true
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.success: eq true
  res.body.data.preserveOriginal: eq true
}

tests {
  test("should write tags preserving original backup file", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.preserveOriginal).to.be.true;
  });
}
