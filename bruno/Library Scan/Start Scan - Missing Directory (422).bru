meta {
  name: Start Scan - Missing Directory (422)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/scan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "directory": "",
    "scanMode": "addNew",
    "recursive": true
  }
}

assert {
  res.status: eq 422
  res.body.success: eq false
  res.body.error.code: eq VALIDATION_ERROR
  res.body.error.details: isDefined
}

tests {
  test("should reject empty directory with 422 validation error", function() {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().success).to.be.false;
    expect(res.getBody().error.code).to.equal('VALIDATION_ERROR');
    expect(res.getBody().error.details[0].field).to.equal('directory');
  });
}
