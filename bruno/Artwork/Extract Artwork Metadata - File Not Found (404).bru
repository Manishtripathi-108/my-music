meta {
  name: Extract Artwork Metadata - File Not Found (404)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/media/artwork
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "path": "{{nonExistentAudioPath}}"
  }
}

assert {
  res.status: eq 404
  res.body.success: eq false
  res.body.error.code: eq NOT_FOUND
}

tests {
  test("should return 404 when file does not exist", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().success).to.be.false;
  });
}
