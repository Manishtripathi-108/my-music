meta {
  name: Start Scan - Invalid Scan Mode (422)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/scan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "directory": "E:/Music",
    "scanMode": "invalid_scan_option",
    "recursive": true
  }
}

assert {
  res.status: eq 422
  res.body.success: eq false
  res.body.error.code: eq VALIDATION_ERROR
  res.body.error.details: isDefined
}

tests {
  test("should reject invalid scanMode with 422", function() {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().success).to.be.false;
    expect(res.getBody().error.code).to.equal('VALIDATION_ERROR');
    expect(res.getBody().error.details[0].field).to.equal('scanMode');
  });
}
