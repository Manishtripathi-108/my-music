meta {
  name: Patch Tags - FLAC Vorbis Comments (200)
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/media/tags
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "path": "{{sampleAudioPathFlac}}",
    "tags": {
      "title": "Master of Puppets",
      "artists": ["Metallica"],
      "album": "Master of Puppets (Remastered)",
      "year": 1986,
      "genres": ["Heavy Metal", "Thrash Metal"],
      "trackNumber": 2
    },
    "preserveOriginal": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.filePath: isDefined
  res.body.data.tags: isDefined
}

tests {
  test("should write tags and return 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.filePath).to.be.a('string');
    expect(res.getBody().data.tags).to.be.an('object');
  });
}
