meta {
  name: Patch Tags - Single File (Happy Path)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/media/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "path": "{{sampleAudioPath}}",
    "tags": {
      "Comment": "Production API Engineering Patch Test"
    },
    "preserveOriginal": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.success: eq true
}

tests {
  test("should partially update tags via PATCH and return 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.success).to.be.true;
  });
}
