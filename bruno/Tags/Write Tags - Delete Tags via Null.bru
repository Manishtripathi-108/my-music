meta {
  name: Write Tags - Delete Tags via Null
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/media/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "path": "{{sampleAudioPath}}",
    "tags": {
      "comment": null,
      "lyrics": null
    },
    "preserveOriginal": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.filePath: isDefined
}

tests {
  test("should delete tags with null values and return 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.filePath).to.be.a('string');
  });
}
