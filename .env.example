/* -------------------------- Server Configuration -------------------------- */
NODE_ENV=development
PORT=3000

/* --------------------- Media Processing Tool Binaries --------------------- */
# If installed globally in system PATH, default executable names suffice.
# Otherwise specify full absolute path (e.g. C:\ffmpeg\ffmpeg.exe).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIAINFO_PATH=MediaInfo

/* -------------------- Engine Selection (Native / WASM) -------------------- */
# Select preferred engine: 'native' (default, maximum speed) or 'wasm' (sandboxed fallback)
METADATA_ENGINE=native
PROBING_ENGINE=native
CONVERSION_ENGINE=native

/* ------------------------- Artwork & Media Cache -------------------------- */
# Path where extracted album artwork and media cache files will be stored.
# Can be relative to project root or an absolute path.
ART_CACHE_DIR=cache/art

