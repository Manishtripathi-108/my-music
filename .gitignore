# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example to be tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vscode
.vscode

# prisma generated files
/src/lib/generated/prisma

# storage folder
/storage

# sitemap and robots.txt
*sitemap*.xml
robots.txt

# Serwist
public/sw*
public/swe-worker*

# Local development files
**/dev
**.db

# Cache and media storage
**/.cache
/cache/
/art/
/music-files/

# Crash-safe atomic write temporaries and original backups
.*.tmp_*
*_original

# Native TagLib worker sidecar build artifacts
/scripts/taglib-worker/build/
/scripts/taglib-worker/taglib-worker.exe
/scripts/taglib-worker/taglib-worker

# CMake & native compilation outputs
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.vcxproj*
*.sln
*.dir/
*.tlog/
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.a

# IDE & OS
.idea
*.suo
*.user