meta {
  name: Stream Artwork - Cache Direct Binary Stream (200)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/media/artwork?file={{sampleArtworkFilename}}
  body: none
  auth: bearer
}

params:query {
  file: {{sampleArtworkFilename}}
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: in [200, 404]
}

tests {
  test("returns image binary or 404 if no cached cover", function() {
    expect([200, 404]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.getHeader('cache-control')).to.include('public');
    }
  });
}
